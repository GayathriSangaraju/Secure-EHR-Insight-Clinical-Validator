# Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_db
DB_USER=postgres
DB_PASSWORD=
# Alternatively set a full SQLAlchemy URL, which takes precedence:
# POSTGRES_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- LLM (used by NeMo Guardrails, see src/guardrails/config.yml) ---
OPENAI_API_KEY=

# --- Optional ---
# Secret used to pseudonymise patient IDs in audit logs. Set a long random value.
AUDIT_HASH_KEY=
# EMBEDDING_MODEL=NeuML/bioclinical-modernbert-base-embeddings
# RETRIEVAL_TOP_K=5
# REDACTION_ENTITIES=PERSON,PHONE_NUMBER,EMAIL_ADDRESS,US_SSN,LOCATION,ORGANIZATION,DATE_TIME
# REDACTION_DENY_LIST=Massachusetts General Hospital,Mayo Clinic,Cleveland Clinic
# REDACTION_SCORE_THRESHOLD=0.4
# API_BASE_URL=http://localhost:8000
# LOG_LEVEL=INFO
